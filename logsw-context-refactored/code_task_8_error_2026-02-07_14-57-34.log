model = ModelFactory.create(model_type=ModelType.GPT_4O_MINI)
researcher = ChatAgent(system_message="You are a researcher.", model=model)
writer = ChatAgent(system_message="You are a writer.", model=model)

# Create workforce and add workers
workforce = Workforce('Research Team')
workforce.add_single_agent_worker(
    'Researcher who finds information',
    worker=researcher,
).add_single_agent_worker(
    'Writer who writes reports',
    worker=writer,
)

# Process task
task = Task(content="Research and write about AI trends.", id="0")
workforce.process_task(task)
```



