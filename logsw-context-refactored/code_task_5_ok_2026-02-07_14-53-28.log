  "content": "import asyncio\nfrom camel.agents import MCPAgent\nfrom camel.models import ModelFactory\nfrom camel.types import BaseMCPRegistryConfig, MCPRegistryType, ModelType\n\nasync def main():\n    # Define the DeepWiki MCP server configuration\n    deepwiki_registry_config = BaseMCPRegistryConfig(\n        type=MCPRegistryType.CUSTOM,\n        url=\"https://mcpservers.org/servers/devin/deepwiki\",\n        os=\"linux\",\n    )\n\n    # Create the model\n    model = ModelFactory.create(model_type=ModelType.GPT_4O_MINI)\n\n    # Create the MCPAgent with the DeepWiki registry config\n    agent = MCPAgent(\n        model=model,\n        registry_configs=[deepwiki_registry_config],\n        function_calling_available=False,\n    )\n\n    # Use the agent asynchronously\n    async with agent:\n        query = \"Retrieve the architecture of the camel-ai/oasis repository.\"\n        response = await agent.astep(query)\n        print(\"Response:\")\n        print(response.msgs[0].content)\n\nif __name__ == \"__main__\":\n    asyncio.run(main())\n",
  "file_path": "task-script/single_agent/5_deepwiki_mcp_agent.py"
