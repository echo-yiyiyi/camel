        local_config_path=str(config_path),
        model=model,
        function_calling_available=False,
    )

    # Query the architecture of the camel-ai/oasis repository
    user_msg = "Retrieve the architecture of the camel-ai/oasis repository."
    response = await mcp_agent.astep(user_msg)

    print(response.msgs[0].content)

    # Disconnect from all MCP servers and clean up resources.
    await mcp_agent.disconnect()


if __name__ == "__main__":
    asyncio.run(main())
```

The MCP server config file `mcp_servers_deepwiki_config.json` used by this script should be:

```json
{
  "mcpServers": {},
  "mcpWebServers": {
    "deepwiki": {
      "url": "https://mcpservers.org/servers/devin/deepwiki"
    }
  }
}
```

Save the script as `task-script/single_agent/5_deepwiki_mcp_agent.py` and the config as `task-script/single_agent/mcp_servers_deepwiki_config.json`.

Run the script with Python 3 to create the agent, connect to the DeepWiki MCP server, and query the architecture of the camel-ai/oasis repository.

