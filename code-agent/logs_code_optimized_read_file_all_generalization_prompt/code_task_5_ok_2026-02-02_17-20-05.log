  "content": "\"\"\"\nScript to create an MCPAgent with MCP tools using the DeepWiki server to retrieve the architecture of the camel-ai/oasis repository.\n\"\"\"\nimport asyncio\nimport platform\nfrom camel.agents import MCPAgent\nfrom camel.models import ModelFactory\nfrom camel.types import ModelPlatformType, ModelType\nfrom camel.types import BaseMCPRegistryConfig, MCPRegistryType\n\nasync def main():\n    # Define DeepWiki MCP registry config\n    deepwiki_registry_config = BaseMCPRegistryConfig(\n        type=MCPRegistryType.CUSTOM,\n        os=platform.system().lower(),\n        name=\"deepwiki\",\n        url=\"https://mcpservers.org/servers/devin/deepwiki\",\n        token=None  # Set token if required\n    )\n\n    # Create model\n    model = ModelFactory.create(\n        model_platform=ModelPlatformType.LLAMA,\n        model_type=ModelType.LLAMA_3_1_8B,\n    )\n\n    # Create MCPAgent with the registry config and model\n    agent = await MCPAgent.create(\n        registry_configs=[deepwiki_registry_config],\n        model=model,\n        function_calling_available=True,\n    )\n\n    # Query to retrieve the architecture of the camel-ai/oasis repository\n    query = \"Retrieve the architecture of the camel-ai/oasis repository.\"\n\n    # Run one step of the agent with the query\n    response = await agent.astep(query)\n\n    # Print the response\n    print(\"Response from DeepWiki MCP agent:\")\n    print(response.msgs[0].content)\n\n    # Disconnect the agent\n    await agent.disconnect()\n\nif __name__ == \"__main__\":\n    asyncio.run(main())\n",
  "file_path": "task-script/single_agent/5_deepwiki_mcp_agent.py"
}
