  "content": "from camel.agents import ChatAgent\nfrom camel.models import ModelFactory\nfrom camel.models.enums import ModelPlatformType, ModelType\nfrom camel.toolkits.memory_toolkit import MemoryToolkit\n\n\ndef main():\n    # Create a model instance\n    model = ModelFactory.create(\n        model_platform=ModelPlatformType.LLAMA,\n        model_type=ModelType.LLAMA_3_1_8B\n    )\n\n    # Create a ChatAgent with the model\n    agent = ChatAgent(model=model)\n\n    # Create a MemoryToolkit for the agent\n    memory_toolkit = MemoryToolkit(agent=agent)\n\n    # Add the memory toolkit tools to the agent\n    agent.add_toolkit(memory_toolkit)\n\n    # Example usage: Save some memory\n    save_response = agent.invoke_tool(\n        tool_name=\"save_memory\",\n        tool_input={\"memory_name\": \"chat_history\"}\n    )\n    print(\"Save memory response:\", save_response)\n\n    # Example usage: Load memory\n    load_response = agent.invoke_tool(\n        tool_name=\"load_memory\",\n        tool_input={\"memory_name\": \"chat_history\"}\n    )\n    print(\"Load memory response:\", load_response)\n\n    # Example usage: Clear memory\n    clear_response = agent.invoke_tool(\n        tool_name=\"clear_memory\",\n        tool_input={\"memory_name\": \"chat_history\"}\n    )\n    print(\"Clear memory response:\", clear_response)\n\n    # Run a query with the agent\n    query = \"What is the purpose of memory tools in this agent?\"\n    response = agent.chat(query)\n    print(\"Agent response to query:\", response)\n\n\nif __name__ == \"__main__\":\n    main()\n",
  "file_path": "task-script/single_agent/10_memory_toolkit_agent.py"
}
