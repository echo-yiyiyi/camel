Args: {
  "content": "\"\"\"\nThis script creates a workforce with multiple single-agent workers using different tools\n(e.g., SearchToolkit) to collaboratively answer the question:\n\"What was the actual enrollment count of the clinical trial on H. pylori in acne vulgaris patients from Jan-May 2018 as listed on the NIH website?\"\n\"\"\"\n\nfrom camel.agents import ChatAgent\nfrom camel.societies.workforce.workforce import Workforce\nfrom camel.societies.workforce.single_agent_worker import SingleAgentWorker\nfrom camel.toolkits import search_toolkit\nfrom camel.model import ModelFactory\nfrom camel.types.enums import ModelPlatformType, ModelType\n\n\ndef main():\n    # Create a workforce\n    workforce = Workforce()\n\n    # Create a search agent using SearchToolkit with DuckDuckGo\n    search_toolkit_instance = search_toolkit.SearchToolkit()\n\n    # Create different agents with different tools\n    # Agent 1: Search agent using DuckDuckGo\n    search_agent = ChatAgent(\n        name=\"SearchAgent\",\n        model=ModelFactory.create(\n            model_platform=ModelPlatformType.OPENAI,\n            model_type=ModelType.QWEN_2_5_14B  # Use the exact model type as requested\n        ),\n        toolkit=search_toolkit_instance\n    )\n\n    # Agent 2: Analyst agent (no external tools, just reasoning)\n    analyst_agent = ChatAgent(\n        name=\"AnalystAgent\",\n        model=ModelFactory.create(\n            model_platform=ModelPlatformType.OPENAI,\n            model_type=ModelType.QWEN_2_5_14B\n        )\n    )\n\n    # Agent 3: Writer agent (to produce final answer)\n    writer_agent = ChatAgent(\n        name=\"WriterAgent\",\n        model=ModelFactory.create(\n            model_platform=ModelPlatformType.OPENAI,\n            model_type=ModelType.QWEN_2_5_14B\n        )\n    )\n\n    # Create workers for each agent\n    search_worker = SingleAgentWorker(agent=search_agent)\n    analyst_worker = SingleAgentWorker(agent=analyst_agent)\n    writer_worker = SingleAgentWorker(agent=writer_agent)\n\n    # Add workers to the workforce\n    workforce.add_worker(search_worker)\n    workforce.add_worker(analyst_worker)\n    workforce.add_worker(writer_worker)\n\n    # Define the question\n    question = (\n        \"What was the actual enrollment count of the clinical trial on H. pylori in acne vulgaris patients \"\n        \"from Jan-May 2018 as listed on the NIH website?\"\n    )\n\n    # Add the task to the workforce\n    task_id = workforce.add_task(question)\n\n    # Run the workforce to process the task\n    results = workforce.run()\n\n    # Print the results\n    print(f\"Results for task {task_id}:\")\n    for worker_name, result in results.items():\n        print(f\"Worker: {worker_name}\")\n        print(result)\n        print(\"---\")\n\n\nif __name__ == \"__main__\":\n    main()\n",
  "file_path": "task-script/workforce/1_answer_question.py"
}
